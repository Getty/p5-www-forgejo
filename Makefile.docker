# Throwaway Forgejo for the live tests (t/9*-live-*.t), from docker-compose.yaml.
#
#   eval "$(make -s -f Makefile.docker setup)"   # start it, admin user, token: prints the exports
#   make -f Makefile.docker test                 # run the live tests against it
#   make -f Makefile.docker down                 # remove it, data included
#
# The compose project name is fixed so every call reaches the same containers
# and volume; the instance listens on localhost only.

export COMPOSE_PROJECT_NAME ?= wwwforgejo-live
export TEST_FORGEJO_URL ?= http://localhost:13080

.PHONY: setup up test test-verbose check stop down logs

setup:
	@scripts/setup-forgejo-test.sh

up:
	docker compose up -d forgejo

test:
	@test -n "$$TEST_FORGEJO_TOKEN" || { echo 'TEST_FORGEJO_TOKEN not set; run: eval "$$(make -s -f Makefile.docker setup)"' >&2; exit 1; }
	prove -l t/9*-live-*.t

test-verbose:
	@test -n "$$TEST_FORGEJO_TOKEN" || { echo 'TEST_FORGEJO_TOKEN not set; run: eval "$$(make -s -f Makefile.docker setup)"' >&2; exit 1; }
	prove -lv t/9*-live-*.t

check:
	@curl -sf $(TEST_FORGEJO_URL)/api/v1/version && echo || echo "Forgejo is not answering at $(TEST_FORGEJO_URL)"

stop:
	docker compose stop

down:
	docker compose down -v

logs:
	docker compose logs -f --tail=100
